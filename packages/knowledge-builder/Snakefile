        ],
        storage(f"swift://{CONTAINER}/arath/tair10/tair10/blast/nucl/cds.tar.gz"),
        storage(f"swift://{CONTAINER}/arath/tair10/tair10/blast/nucl/mrna.tar.gz"),
        storage(f"swift://{CONTAINER}/arath/tair10/tair10/blast/prot/protein.tar.gz"),
        storage(f"swift://{CONTAINER}/arath/tair10/tair10/diamond/protein.dmnd"),
        [
            storage(f"swift://{CONTAINER}/arath/tair10/araport11/{t}.fa.gz{ext}")
            for t in GFF_FEATURE_TYPES
            for ext in ["", ".fai", ".gzi"]
        ],
        storage(f"swift://{CONTAINER}/arath/tair10/araport11/blast/nucl/cds.tar.gz"),
        storage(f"swift://{CONTAINER}/arath/tair10/araport11/blast/nucl/mrna.tar.gz"),
        storage(f"swift://{CONTAINER}/arath/tair10/araport11/blast/prot/protein.tar.gz"),
        storage(f"swift://{CONTAINER}/arath/tair10/araport11/diamond/protein.dmnd"),
