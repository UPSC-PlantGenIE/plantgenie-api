configfile: "config.yaml"

import base64
from pathlib import Path
from shared.services.openstack import SwiftClient


CONTAINER = config["container"]
BUCKET_URL = config["bucket_url"]


def upload_build_artifacts(status: str, snakemake_log) -> None:
    run_id = config.get("run_id")
    if not run_id:
        return
    log_path = snakemake_log[0] if isinstance(snakemake_log, list) else snakemake_log
    client = SwiftClient()
    prefix = f"builds/{run_id}"
    client.upload(
        CONTAINER, f"{prefix}/{status}-{run_id}", Path(log_path)
    )
    log_dir = Path(".snakemake/log")
    for path in log_dir.rglob("*"):
        if path.is_file():
            rel = path.relative_to(log_dir)
            client.upload(CONTAINER, f"{prefix}/logs/{rel}", path)
    meta_dir = Path(".snakemake/metadata")
    for path in meta_dir.iterdir() if meta_dir.is_dir() else []:
        if not path.is_file():
            continue
        output_path = base64.urlsafe_b64decode(path.name).decode()
        if output_path.startswith("swift://"):
            output_path = output_path.split("/", 3)[-1]
        client.upload(CONTAINER, f"{prefix}/metadata/{output_path}.json", path)


onsuccess:
    upload_build_artifacts("SUCCESS", log)


onerror:
    upload_build_artifacts("FAILED", log)


GFF_FEATURE_TYPES = ["cds", "mrna", "protein"]


# Bucket layout mirrors the graph ids: <taxon>/<assembly>/[<annotation>/].
# Genome assets live at the assembly level, transcript assets at the
# annotation level.
rule all:
    input:
        # --- betpe/v1 (annotation v1.2) ---
        [
            storage(f"swift://{CONTAINER}/betpe/v1/genome.fa.gz{ext}")
            for ext in ["", ".fai", ".gzi"]
        ],
        storage(f"swift://{CONTAINER}/betpe/v1/blast/nucl/genome.tar.gz"),
        [
            storage(f"swift://{CONTAINER}/betpe/v1/v1.2/{t}.fa.gz{ext}")
            for t in GFF_FEATURE_TYPES
            for ext in ["", ".fai", ".gzi"]
        ],
        storage(f"swift://{CONTAINER}/betpe/v1/v1.2/blast/nucl/cds.tar.gz"),
        storage(f"swift://{CONTAINER}/betpe/v1/v1.2/blast/nucl/mrna.tar.gz"),
        storage(f"swift://{CONTAINER}/betpe/v1/v1.2/blast/prot/protein.tar.gz"),
        storage(f"swift://{CONTAINER}/betpe/v1/v1.2/diamond/protein.dmnd"),
        # --- arath/tair10 (annotations tair10, araport11) ---
        [
            storage(f"swift://{CONTAINER}/arath/tair10/genome.fa.gz{ext}")
            for ext in ["", ".fai", ".gzi"]
        ],
        storage(f"swift://{CONTAINER}/arath/tair10/blast/nucl/genome.tar.gz"),
        [
            storage(f"swift://{CONTAINER}/arath/tair10/tair10/{t}.fa.gz{ext}")
