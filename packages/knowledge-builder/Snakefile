configfile: "config.yaml"

from pathlib import Path
from shared.services.openstack import SwiftClient


CONTAINER = config["container"]


def upload_build_artifacts(status: str, snakemake_log) -> None:
    run_id = config.get("run_id")
    if not run_id:
        return
    log_path = snakemake_log[0] if isinstance(snakemake_log, list) else snakemake_log
    client = SwiftClient()
    prefix = f"builds/{run_id}"
    client.upload(
        CONTAINER, f"{prefix}/{status}-{run_id}", Path(log_path)
    )
    log_dir = Path(".snakemake/log")
    for path in log_dir.rglob("*"):
        if path.is_file():
            rel = path.relative_to(log_dir)
            client.upload(CONTAINER, f"{prefix}/logs/{rel}", path)


onsuccess:
    upload_build_artifacts("SUCCESS", log)


onerror:
    upload_build_artifacts("FAILED", log)

GENOMES = [
    "Bepen_v1p2_genome.fa",
    "Arabidopsis_thaliana.TAIR10.dna.toplevel.fa",
    "Tieton02_genome.fasta",
    # "Potra02_genome.fasta",  # FTP source (port 980) unreachable for now
]


rule all:
    input:
        [
            storage(q)
            for q in expand(
                f"swift://{CONTAINER}/{{stem}}.gz{{ext}}",
                stem=GENOMES,
                ext=["", ".fai", ".gzi"],
            )
        ],


rule index_genome:
    input:
        "normalized/{stem}",
    output:
        gz=storage(f"swift://{CONTAINER}/{{stem}}.gz"),
        fai=storage(f"swift://{CONTAINER}/{{stem}}.gz.fai"),
        gzi=storage(f"swift://{CONTAINER}/{{stem}}.gz.gzi"),
    shell:
        """
        bgzip -c {input} > {output.gz}
        samtools faidx {output.gz}
        """


rule download_betpe:
    output:
        temp("normalized/Bepen_v1p2_genome.fa"),
    params:
        url="https://genomevolution.org/coge/api/v1/genomes/68624/sequence",
    shell:
        "curl -fsSLk '{params.url}' | sed 's/^>lcl|/>/' > {output}"


rule download_arath:
    output:
        temp("normalized/Arabidopsis_thaliana.TAIR10.dna.toplevel.fa"),
    params:
        url="https://ftp.ensemblgenomes.org/pub/plants/release-62/fasta/arabidopsis_thaliana/dna/Arabidopsis_thaliana.TAIR10.dna.toplevel.fa.gz",
    shell:
        "curl -fsSLk '{params.url}' | gunzip -c > {output}"


rule download_pruav:
    output:
        temp("normalized/Tieton02_genome.fasta"),
    params:
        url="https://www.rosaceae.org/rosaceae_downloads/Prunus_avium/Prunus_avium_Tieton.v2.0.a1/assembly/Prunus_avium_Tieton.chr.fasta.gz",
    shell:
        "curl -fsSLk '{params.url}' | gunzip -c > {output}"


