        storage(f"swift://{CONTAINER}/pruav/v2/v2.0/diamond/protein.dmnd"),


# --- mechanical rules: mirror a local path to the same bucket path ---

rule index_genome:
    input:
        "normalized/{path}/genome.fa",
    output:
        gz=storage(f"swift://{CONTAINER}/{{path}}/genome.fa.gz"),
        fai=storage(f"swift://{CONTAINER}/{{path}}/genome.fa.gz.fai"),
        gzi=storage(f"swift://{CONTAINER}/{{path}}/genome.fa.gz.gzi"),
    shell:
        """
        bgzip -c {input} > {output.gz}
        samtools faidx {output.gz}
        """


rule index_transcript:
    input:
        "gffread/{path}/{ftype}.fa",
    output:
        gz=storage(f"swift://{CONTAINER}/{{path}}/{{ftype}}.fa.gz"),
        fai=storage(f"swift://{CONTAINER}/{{path}}/{{ftype}}.fa.gz.fai"),
        gzi=storage(f"swift://{CONTAINER}/{{path}}/{{ftype}}.fa.gz.gzi"),
    wildcard_constraints:
        ftype="cds|mrna|protein",
    shell:
        """
        bgzip -c {input} > {output.gz}
        samtools faidx {output.gz}
        """


rule blastdb_genome:
    input:
        "normalized/{path}/genome.fa",
    output:
        storage(f"swift://{CONTAINER}/{{path}}/blast/nucl/genome.tar.gz"),
    shell:
        """
        tmp=$(mktemp -d)
        makeblastdb -in {input} -dbtype nucl -out $tmp/genome
        tar -czf {output} -C $tmp .
        rm -rf $tmp
        """


rule blastdb_transcript_nucl:
    input:
        "gffread/{path}/{ftype}.fa",
    output:
        storage(f"swift://{CONTAINER}/{{path}}/blast/nucl/{{ftype}}.tar.gz"),
    wildcard_constraints:
        ftype="cds|mrna",
    shell:
        """
        tmp=$(mktemp -d)
        makeblastdb -in {input} -dbtype nucl -out $tmp/{wildcards.ftype}
        tar -czf {output} -C $tmp .
        rm -rf $tmp
        """


rule blastdb_protein:
    input:
        "gffread/{path}/protein.fa",
    output:
        storage(f"swift://{CONTAINER}/{{path}}/blast/prot/protein.tar.gz"),
    shell:
        """
        tmp=$(mktemp -d)
        makeblastdb -in {input} -dbtype prot -out $tmp/protein
        tar -czf {output} -C $tmp .
        rm -rf $tmp
        """


rule diamond_protein:
    input:
        "gffread/{path}/protein.fa",
    output:
        storage(f"swift://{CONTAINER}/{{path}}/diamond/protein.dmnd"),
    shell:
        """
        out={output}
        diamond makedb --in {input} -d "${{out%.dmnd}}"
        """


# --- explicit per-genome downloads (carry source-specific normalization) ---

rule download_betpe:
    output:
        temp("normalized/betpe/v1/genome.fa"),
    params:
        url="https://genomevolution.org/coge/api/v1/genomes/68624/sequence",
    shell:
        "curl -fsSLk '{params.url}' | sed 's/^>lcl|/>/' > {output}"


rule download_arath:
    output:
        temp("normalized/arath/tair10/genome.fa"),
    params:
        url="https://ftp.ensemblgenomes.org/pub/plants/release-62/fasta/arabidopsis_thaliana/dna/Arabidopsis_thaliana.TAIR10.dna.toplevel.fa.gz",
    shell:
        "curl -fsSLk '{params.url}' | gunzip -c > {output}"


rule download_pruav:
    output:
        temp("normalized/pruav/v2/genome.fa"),
    params:
        url="https://www.rosaceae.org/rosaceae_downloads/Prunus_avium/Prunus_avium_Tieton.v2.0.a1/assembly/Prunus_avium_Tieton.chr.fasta.gz",
    shell:
        "curl -fsSLk '{params.url}' | gunzip -c > {output}"


