# --- explicit per-annotation gff downloads ---

rule download_gff_betpe:
    output:
        temp("gff/Bepen_v1p2_coge_sorted.gff3"),
    params:
        url=f"{BUCKET_URL}/Bepen_v1p2_coge_sorted.gff3.gz",
    shell:
        "curl -fsSL '{params.url}' | gunzip -c > {output}"


rule download_gff_tair10:
    output:
        temp("gff/TAIR10_GFF3_genes_sorted.gff3"),
    params:
        url=f"{BUCKET_URL}/TAIR10_GFF3_genes_sorted.gff3.gz",
    shell:
        # gff seqids are Chr1..Chr5/ChrC/ChrM; the Ensembl genome uses
        # 1..5/Pt/Mt, so rewrite the seqid column to match
        "curl -fsSL '{params.url}' | gunzip -c | "
        r"sed -E '/^#/!{{s/^Chr([1-5])\t/\1\t/; s/^ChrC\t/Pt\t/; s/^ChrM\t/Mt\t/}}'"
        " > {output}"


rule download_gff_araport11:
    output:
        temp("gff/TAIR10_araport11_sorted.gff3"),
    params:
        url=f"{BUCKET_URL}/TAIR10_araport11_sorted.gff3.gz",
    shell:
        "curl -fsSL '{params.url}' | gunzip -c > {output}"


rule download_gff_pruav:
    output:
        temp("gff/Tieton02_original_sorted.gff3"),
    params:
        url=f"{BUCKET_URL}/Tieton02_original_sorted.gff3.gz",
    shell:
        "curl -fsSL '{params.url}' | gunzip -c > {output}"


# --- explicit per-annotation gffread (genome + gff -> cds/mrna/protein) ---

rule gffread_betpe:
    input:
        genome="normalized/betpe/v1/genome.fa",
        gff="gff/Bepen_v1p2_coge_sorted.gff3",
    output:
        cds=temp("gffread/betpe/v1/v1.2/cds.fa"),
        mrna=temp("gffread/betpe/v1/v1.2/mrna.fa"),
        protein=temp("gffread/betpe/v1/v1.2/protein.fa"),
    shell:
        r"""
        gffread {input.gff} -g {input.genome} \
            -x {output.cds} -w {output.mrna} -y {output.protein}
        sed -i '/^>/!s/\./X/g' {output.protein}
        sed -i '/^>/!s/\./N/g' {output.cds} {output.mrna}
        """


