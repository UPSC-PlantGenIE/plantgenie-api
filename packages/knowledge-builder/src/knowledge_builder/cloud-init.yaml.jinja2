#cloud-config
package_update: true

apt:
  sources:
    docker.list:
      source: deb https://download.docker.com/linux/ubuntu noble stable
      keyid: 9DC858229FC7DD38854AE2D88D81803C0EBFCD88
      arches: [ amd64 ]

packages:
  - docker-ce
  - docker-ce-cli
  - containerd.io
  - python3-openstackclient

runcmd:
  - systemctl enable docker
  - systemctl start docker
  - |
    echo "{{ ghcr_pat }}" |\
    docker login ghcr.io -u "{{ ghcr_user }}" --password-stdin
  - |
    IMAGE=ghcr.io/upsc-plantgenie/plantgenie-api/knowledge-builder:{{ kb_image_tag }}
    docker run --rm \
      --entrypoint snakemake \
      -e OS_AUTH_TYPE={{ os_auth_type }} \
      -e OS_AUTH_URL={{ os_auth_url }} \
      -e OS_APPLICATION_CREDENTIAL_ID={{ os_app_cred_id }} \
      -e OS_APPLICATION_CREDENTIAL_SECRET={{ os_app_cred_secret }} \
      "$IMAGE" \
      --cores all \
      --config run_id={{ run_id }} container={{ bucket }}
  - STATUS=$?

  - export OS_AUTH_TYPE={{ os_auth_type }}
  - export OS_AUTH_URL={{ os_auth_url }}
  - export OS_APPLICATION_CREDENTIAL_ID={{ os_app_cred_id }}
  - export OS_APPLICATION_CREDENTIAL_SECRET={{ os_app_cred_secret }}
  - openstack object create {{ bucket }} /var/log/cloud-init-output.log --name builds/{{ run_id }}/cloud-init.log
  - |
    if [ "${STATUS}" -eq 0 ]
        then
            touch /tmp/SUCCESS
            openstack object create {{ bucket }} /tmp/SUCCESS --name builds/{{ run_id }}/SUCCESS
        else
            touch /tmp/FAILED
            openstack object create {{ bucket }} /tmp/FAILED --name builds/{{ run_id }}/FAILED
    fi
    # - poweroff   # disabled for debugging; VM stays up so we can read logs
