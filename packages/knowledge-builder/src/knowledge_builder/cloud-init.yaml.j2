#cloud-config
package_update: true

apt:
  sources:
    docker.list:
      source: deb https://download.docker.com/linux/ubuntu noble stable
      keyid: 9DC858229FC7DD38854AE2D88D81803C0EBFCD88
      arches: [ amd64 ]

packages:
  - docker-ce
  - docker-ce-cli
  - containerd.io

runcmd:
  - systemctl enable docker
  - systemctl start docker
  - |
    echo "{{ ghcr_pat }}" |\
    docker login ghcr.io -u "{{ ghcr_user }}" --password-stdin
  - |
    IMAGE=ghcr.io/upsc-plantgenie/plantgenie-api/knowledge-builder:{{ kb_image_tag }}
    docker run --rm \
      --entrypoint snakemake \
      -e OS_AUTH_TYPE={{ os_auth_type }} \
      -e OS_AUTH_URL={{ os_auth_url }} \
      -e OS_APPLICATION_CREDENTIAL_ID={{ os_app_cred_id }} \
      -e OS_APPLICATION_CREDENTIAL_SECRET={{ os_app_cred_secret }} \
      "$IMAGE" \
      --cores all \
      --config run_id={{ run_id }} container={{ bucket }} || true
    docker run --rm \
      --entrypoint kb-upload \
      -e OS_AUTH_TYPE={{ os_auth_type }} \
      -e OS_AUTH_URL={{ os_auth_url }} \
      -e OS_APPLICATION_CREDENTIAL_ID={{ os_app_cred_id }} \
      -e OS_APPLICATION_CREDENTIAL_SECRET={{ os_app_cred_secret }} \
      -v /var/log/cloud-init-output.log:/tmp/ci.log:ro \
      "$IMAGE" \
      {{ bucket }} builds/{{ run_id }}/cloud-init.log /tmp/ci.log
  # - poweroff   # disabled for debugging; VM stays up so we can read logs
